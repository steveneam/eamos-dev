#!/bin/sh
# eamos pre-commit — commit-time guard gate.
#
# Installed by scripts/install-hooks.mjs (which sets core.hooksPath=scripts/hooks),
# so this tracked file is the hook every clone and worktree runs — no per-clone
# copy that goes stale.
#
# Runs three guards, each GATING the commit on a non-zero exit — the exit code is
# the contract. Every guard is checked with an explicit `if ! guard; then exit 1`
# block; the hook never chains guard + commit in a form that could swallow a
# non-zero exit (the semicolon-chain trap that leaked a guarded token on
# Thalon/Swordfish). See CI-GUARD.md.
#
#   1. eamos-vercel-project-guard --require-root-link   (always)
#   2. eamos-grep-guard                                 (always — secrets + conflict markers)
#   3. eamos-peer-mail status --staging-only            (always — peer-owned inbox protection)
#   4. eamos-handoff-lint --strict                      (only when agent_handoff/CURRENT.md is staged)
#
# Degrades to a no-op (with a notice) when Node is unavailable.

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found — skipping eamos guards (install Node to enable)."
  exit 0
fi

# 1) Vercel project link guard — always.
if ! node scripts/eamos-vercel-project-guard.mjs --require-root-link; then
  echo ""
  echo "pre-commit: Vercel project guard failed."
  echo "Remove app/web/.vercel and keep repo-root .vercel linked to eamos-dev."
  exit 1
fi

# 2) Secret-shape + merge-conflict-marker guard — always (scans git-tracked files).
if ! node scripts/eamos-grep-guard.mjs; then
  echo ""
  echo "pre-commit: grep-guard found a secret-shaped token or conflict marker (see above)."
  echo "Remove it from the tracked tree, then commit again."
  exit 1
fi

# 3) Peer-mail ownership guard — never commit a watcher/peer-owned inbox.
if ! node scripts/eamos-peer-mail.mjs status --staging-only; then
  echo ""
  echo "pre-commit: peer-mail staging guard failed."
  echo "Unstage peer-owned inbound mail; its writer owns the commit."
  exit 1
fi

# 4) Handoff anti-bloat lint (strict) — only when the live handoff file is staged.
if git diff --cached --name-only | grep -q '^agent_handoff/CURRENT\.md$'; then
  if ! node scripts/eamos-handoff-lint.mjs --strict; then
    echo ""
    echo "pre-commit: agent_handoff/CURRENT.md failed handoff-lint --strict (see above)."
    echo "Trim it to the lean form (README Hard Rule 9), then commit again."
    exit 1
  fi
fi

exit 0
