# Variant Evidence Report to FastAPI backend.
#
# Leave NEXT_PUBLIC_API_BASE_URL empty (the default) to call same-origin
# `/api/*`, which next.config.ts rewrites to the FastAPI dev server with no CORS.
# Set it to an absolute origin (e.g. https://api.example.com) to call a remote
# backend directly instead.
NEXT_PUBLIC_API_BASE_URL=

# Backend origin the dev rewrite proxies to (defaults to http://localhost:8532).
# In PRODUCTION on Vercel, set this to your hosted FastAPI origin so the
# same-origin /api/* proxy reaches the live backend (no CORS needed), e.g.
# API_PROXY_TARGET=https://eamos-api.onrender.com
# API_PROXY_TARGET=http://localhost:8532

# Messenger evidence submissions: when "true", the /account Messenger form POSTs
# to the backend `POST /api/v1/evidence-submissions` (Supabase bearer token; real
# EAMOS-EVS-… tracking id + ClinVar draft payload) and exposes the optional
# ClinVar functional-evidence fields. Leave unset/false to keep the mock-first
# direct-Supabase write (tracking id stays PENDING). Only turn ON once Supabase
# migration 0003 is applied and the backend has SUPABASE_URL /
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_JWT_SECRET set.
# NEXT_PUBLIC_EVIDENCE_API_ENABLED=false

# =========================================================================
# Supabase (AWS Sydney ap-southeast-2) — user/submission metadata only.
# Genomic data is NOT stored here; it stays live via the FastAPI backend.
# Use ONLY the publishable key on the client. NEVER expose the secret key.
# =========================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# =========================================================================
# PostHog Analytics (US Cloud) — async/background capture only.
# =========================================================================
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# =========================================================================
# Stripe (AU) — payment links / hosted checkout. Publishable key is safe on
# the client; the SECRET key (sk_...) belongs ONLY in server env, never here.
# =========================================================================
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# =========================================================================
# Sentry — error/crash + performance monitoring (Next.js project ONLY).
# The DSN is a publishable client identifier (it ships in the browser bundle),
# so it is safe on the client. Leave unset to disable Sentry entirely (no-op).
# Use the JavaScript/Next.js project DSN here — NOT the Python/backend DSN.
# =========================================================================
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXXXXX.ingest.us.sentry.io/XXXXXXXX
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
#
# Source-map upload at build time (Vercel/CI). org='eamos' and
# project='javascript-nextjs' are defaulted in next.config.mjs, so for readable
# stack traces you only need the SECRET auth token set in the Vercel project env
# (never commit it). Override the defaults here only if the slugs change:
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx
# SENTRY_ORG=eamos
# SENTRY_PROJECT=javascript-nextjs
