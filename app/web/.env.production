# DEMO BRANCH ONLY (demo/ai-chat-preview) — do NOT merge to main.
# Lights up the gated Ask-Eamos chat on this Vercel PREVIEW build and proxies
# /api/* to the gateway-flipped Render backend, so the preview is a self-contained
# AI-chat demo. Production (built from main) never sees this file, so the prod
# /report keeps the chat hidden. Tear down by deleting this branch.
NEXT_PUBLIC_AI_CHAT_ENABLED=true
API_PROXY_TARGET=https://eamos-dev-sg.onrender.com
