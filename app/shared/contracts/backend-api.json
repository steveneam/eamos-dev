{
  "openapi": "3.1.0",
  "info": {
    "title": "Eamos Backend API",
    "version": "1.0.0",
    "description": "Genomic variant intelligence API. Base URL: http://localhost:8000"
  },
  "endpoints": {
    "register": {
      "method": "POST",
      "path": "/api/v1/auth/register",
      "tags": ["auth"],
      "summary": "Register a new user account",
      "requestBody": { "schema": "RegisterRequest" },
      "response": {
        "201": { "schema": "TokenResponse", "description": "JWT access token issued on successful registration" }
      }
    },
    "login": {
      "method": "POST",
      "path": "/api/v1/auth/login",
      "tags": ["auth"],
      "summary": "Authenticate and receive a JWT token",
      "requestBody": { "schema": "LoginRequest" },
      "response": {
        "200": { "schema": "TokenResponse", "description": "JWT access token" }
      }
    },
    "logout": {
      "method": "POST",
      "path": "/api/v1/auth/logout",
      "tags": ["auth"],
      "summary": "Invalidate the current bearer token",
      "security": ["bearerAuth"],
      "response": {
        "204": { "description": "Token revoked; no body returned" }
      }
    },
    "me": {
      "method": "GET",
      "path": "/api/v1/auth/me",
      "tags": ["auth"],
      "summary": "Return the currently authenticated user",
      "security": ["bearerAuth"],
      "response": {
        "200": { "schema": "AuthUser", "description": "Authenticated user profile" }
      }
    },
    "variant_lookup": {
      "method": "POST",
      "path": "/api/v1/lookup",
      "tags": ["lookup"],
      "summary": "Run the full variant evidence pipeline for a gene + HGVS variant",
      "requestBody": { "schema": "LookupRequest" },
      "response": {
        "200": { "schema": "LookupResponse", "description": "Aggregated evidence from ClinVar, VEP, SpliceAI, gnomAD, AlphaMissense, PubMed, etc." }
      }
    },
    "upload_report": {
      "method": "POST",
      "path": "/api/v1/reports/upload",
      "tags": ["reports"],
      "summary": "Upload a patient report file (multipart/form-data)",
      "requestBody": {
        "contentType": "multipart/form-data",
        "fields": {
          "file": "binary — the report file",
          "report_kind": "string enum (default: 'test') — ReportKind"
        }
      },
      "response": {
        "201": { "schema": "ReportUploadResponse", "description": "Metadata for the ingested report" }
      }
    },
    "review_report": {
      "method": "POST",
      "path": "/api/v1/reports/{report_id}/review",
      "tags": ["reviews"],
      "summary": "Submit a clinician review for a patient report",
      "pathParams": { "report_id": "string — report identifier" },
      "requestBody": { "schema": "ClinicianReviewPayload" },
      "response": {
        "200": { "schema": "ReviewResult", "description": "Updated review state" }
      }
    },
    "create_run": {
      "method": "POST",
      "path": "/api/v1/runs",
      "tags": ["runs"],
      "summary": "Create and queue a new variant analysis run",
      "requestBody": { "schema": "RunRequest" },
      "response": {
        "200": { "schema": "RunResponse", "description": "Run record with status and initial draft" }
      }
    },
    "get_run": {
      "method": "GET",
      "path": "/api/v1/runs/{run_id}",
      "tags": ["runs"],
      "summary": "Retrieve the current state of a run",
      "pathParams": { "run_id": "string — run identifier" },
      "response": {
        "200": { "schema": "RunResponse", "description": "Full run record including draft payload" }
      }
    },
    "update_run_report_payload": {
      "method": "PATCH",
      "path": "/api/v1/runs/{run_id}/report-payload",
      "tags": ["runs"],
      "summary": "Edit the draft report payload for a run",
      "pathParams": { "run_id": "string — run identifier" },
      "requestBody": { "schema": "ReportDraftUpdatePayload" },
      "response": {
        "200": { "schema": "RunResponse", "description": "Run with updated draft payload" }
      }
    },
    "chat_on_run": {
      "method": "POST",
      "path": "/api/v1/runs/{run_id}/chat",
      "tags": ["runs"],
      "summary": "Ask a clinical question about a specific run (LLM-backed)",
      "pathParams": { "run_id": "string — run identifier" },
      "requestBody": { "schema": "RunChatRequest" },
      "response": {
        "200": { "schema": "RunChatResponse", "description": "LLM answer in clinical register" }
      }
    },
    "review_run": {
      "method": "POST",
      "path": "/api/v1/runs/{run_id}/review",
      "tags": ["runs", "reviews"],
      "summary": "Submit a clinician review decision for a run",
      "pathParams": { "run_id": "string — run identifier" },
      "requestBody": { "schema": "ClinicianReviewPayload" },
      "response": {
        "200": { "schema": "ReviewResult", "description": "Updated review state for the run" }
      }
    },
    "approve_run": {
      "method": "POST",
      "path": "/api/v1/runs/{run_id}/approve",
      "tags": ["runs"],
      "summary": "Clinician approves and finalises the run report",
      "pathParams": { "run_id": "string — run identifier" },
      "response": {
        "200": { "schema": "ApproveResult", "description": "Finalised run record confirming approval" }
      }
    },
    "drop_run": {
      "method": "POST",
      "path": "/api/v1/runs/{run_id}/drop",
      "tags": ["runs"],
      "summary": "Clinician drops (rejects) a run with an optional review note",
      "pathParams": { "run_id": "string — run identifier" },
      "requestBody": { "schema": "RunDropPayload" },
      "response": {
        "200": { "schema": "DropResult", "description": "Updated run record marked as dropped" }
      }
    },
    "get_run_pdf": {
      "method": "GET",
      "path": "/api/v1/runs/{run_id}/pdf",
      "tags": ["runs"],
      "summary": "Stream the finalised PDF report for a run (also accepts HEAD)",
      "pathParams": { "run_id": "string — run identifier" },
      "response": {
        "200": {
          "contentType": "application/pdf",
          "description": "PDF report served inline; also responds to HEAD for existence check"
        }
      }
    },
    "search": {
      "method": "GET",
      "path": "/api/v1/search",
      "tags": ["search"],
      "summary": "Full-text search across runs and reports",
      "queryParams": {
        "q": "string (required, min length 1) — search query",
        "limit": "integer (1–50, default 10) — maximum results",
        "doc_type": "string (optional) — filter by document type",
        "run_status": "string (optional) — filter by run status",
        "review_status": "string (optional) — filter by review status"
      },
      "response": {
        "200": { "schema": "SearchResponse", "description": "Ranked list of matching documents" }
      }
    },
    "search_answer": {
      "method": "POST",
      "path": "/api/v1/search/answer",
      "tags": ["search"],
      "summary": "Ask a natural-language question answered from the search index (LLM-backed)",
      "requestBody": { "schema": "SearchAnswerRequest" },
      "response": {
        "200": { "schema": "SearchAnswerResponse", "description": "LLM-synthesised answer with source citations" }
      }
    },
    "healthz": {
      "method": "GET",
      "path": "/healthz",
      "tags": ["health"],
      "summary": "Liveness probe — checks API process and database connectivity",
      "response": {
        "200": {
          "description": "Service is healthy",
          "example": { "status": "ok", "database": "ok" }
        }
      }
    }
  },
  "schemas": {
    "RegisterRequest": "app/backend/app/schemas/auth.py — email, password, display_name",
    "LoginRequest": "app/backend/app/schemas/auth.py — email, password",
    "TokenResponse": "app/backend/app/schemas/auth.py — access_token, token_type",
    "AuthUser": "app/backend/app/schemas/auth.py — id, email, display_name, role",
    "LookupRequest": "app/backend/app/schemas/lookup.py — gene, cdna (HGVS), species, use_real_apis flag",
    "LookupResponse": "app/backend/app/schemas/lookup.py — variant metadata, tool results, ACMG classification",
    "ReportUploadResponse": "app/backend/app/schemas/report.py — report_id, filename, report_kind, status",
    "ReportKind": "app/backend/app/schemas/report.py — enum: test | clinical | research",
    "RunRequest": "app/backend/app/schemas/run.py — gene, cdna, species, report_kind",
    "RunResponse": "app/backend/app/schemas/run.py — run_id, status, review_status, report_payload, created_at",
    "ReportDraftUpdatePayload": "app/backend/app/schemas/draft.py — partial update fields for report_payload",
    "ClinicianReviewPayload": "app/backend/app/schemas/draft.py — decision, review_note",
    "ReviewResult": "app/backend/app/schemas/draft.py — run_id, review_status, review_note, reviewed_at",
    "ApproveResult": "app/backend/app/schemas/draft.py — run_id, approved_at, pdf_path",
    "DropResult": "app/backend/app/schemas/draft.py — run_id, dropped_at, review_note",
    "RunDropPayload": "app/backend/app/schemas/draft.py — review_note (optional)",
    "RunChatRequest": "app/backend/app/schemas/chat.py — message",
    "RunChatResponse": "app/backend/app/schemas/chat.py — reply, sources",
    "SearchAnswerRequest": "app/backend/app/schemas/search.py — question",
    "SearchAnswerResponse": "app/backend/app/schemas/search.py — answer, citations",
    "SearchResponse": "app/backend/app/schemas/search.py — results list of SearchHit"
  },
  "state_fields": [
    "run_status",
    "review_status",
    "review_note",
    "reviewed_at"
  ]
}
