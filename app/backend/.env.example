ENV=dev
APP_NAME=eamos-backend
HOST=0.0.0.0
PORT=8000
DEBUG=false
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=./data/uploads
FINAL_REPORT_DIR=./data/final_reports
MAX_UPLOAD_MB=20
DATABASE_URL=sqlite+pysqlite:///./data/app.db
JWT_SECRET=change-me-dev-secret-with-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=auto
SUPABASE_JWKS_URL=
SUPABASE_JWT_PUBLIC_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REST_TIMEOUT_SECONDS=10
SUPABASE_STORAGE_S3_ENDPOINT_URL=
SUPABASE_STORAGE_S3_REGION=
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=
SUPABASE_LOCAL_MODEL_CACHE_ENABLED=false
SUPABASE_LOCAL_MODEL_CACHE_DATABASE_URL=
SUPABASE_LOCAL_MODEL_CACHE_SCHEMA=eamos_private
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX_REQUESTS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_BATCH_UPLOAD_MAX_REQUESTS=10
RATE_LIMIT_LOOKUP_MAX_REQUESTS=30
RATE_LIMIT_CHAT_MAX_REQUESTS=10
RATE_LIMIT_EVIDENCE_MAX_REQUESTS=10
RATE_LIMIT_PAYMENTS_CHECKOUT_MAX_REQUESTS=6
RATE_LIMIT_PAYMENTS_WEBHOOK_MAX_REQUESTS=60
RATE_LIMIT_WORKBENCH_MAX_REQUESTS=20
RATE_LIMIT_TRUST_PROXY_HEADERS=false
BATCH_UPLOAD_REGISTRY_MAX_ENTRIES=128
BATCH_JOB_REGISTRY_MAX_ENTRIES=256
BATCH_REGISTRY_TTL_SECONDS=3600
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
# AI gateway variant chat activates when LLM_PROVIDER=gateway + AI_GATEWAY_API_KEY.
# Dev daily spend-cap: a global (cross-user) backstop on the chat path so the gateway
# credit can't drain while developing against the real gateway / shared-Render demo.
# Leave OFF for free local fake-gateway iteration; turn ON for real-gateway scenarios.
AI_CHAT_DEV_DAILY_CAP_ENABLED=false
AI_CHAT_DEV_DAILY_CAP=1
AI_CHAT_DEV_DAILY_CAP_WINDOW_SECONDS=86400
# Launch per-user budget (pre-launch-security.md HIGH gate): caps chat requests per
# authenticated user per rolling window so one account can't drain the gateway credit.
# 10/user/day = free-tier cap, flat across users for first launch (paid tiers later).
# MUST be ON before any prod FE exposure of chat.
AI_CHAT_USER_DAILY_CAP_ENABLED=false
AI_CHAT_USER_DAILY_CAP=10
AI_CHAT_USER_DAILY_CAP_WINDOW_SECONDS=86400
USE_REAL_APIS=false
LOOKUP_TIMING_DIAGNOSTICS_ENABLED=false
LOOKUP_TIMING_DIAGNOSTICS_MAX_ENTRIES=80
LOCAL_EVIDENCE_ENABLED=false
LOCAL_EVIDENCE_ALLOWED_FLOWS_RAW=
LOCAL_EVIDENCE_REQUIRE_REAL_APIS=true
DBSNP_RUNTIME_VCF_PATH=./data/bio_assets/dbsnp/GCF_000001405.40.gz
DBSNP_RUNTIME_INDEX_PATH=./data/bio_assets/dbsnp/GCF_000001405.40.gz.tbi
CLINVAR_RUNTIME_VCF_PATH=./data/bio_assets/clinvar/clinvar.vcf.gz
CLINVAR_RUNTIME_INDEX_PATH=./data/bio_assets/clinvar/clinvar.vcf.gz.tbi
REPEATMASKER_RUNTIME_INDEX_PATH=./data/bio_assets/repeatmasker/repeatmasker.interval-index.jsonl
PHYLOP_RUNTIME_BIGWIG_PATH=./data/bio_assets/phylop/hg38.phyloP100way.bw
DUCKDB_ANALYTICAL_ENABLED=false
DUCKDB_ANALYTICAL_DATABASE_PATH=./data/bio_assets/analytical/eamos-reference.duckdb
DUCKDB_ANALYTICAL_TEMP_DIRECTORY=./data/bio_assets/analytical/tmp
DUCKDB_ANALYTICAL_MEMORY_LIMIT=1500MB
DUCKDB_ANALYTICAL_THREADS=2
LOCAL_EVIDENCE_RUNTIME_SEED_TIMEOUT_SECONDS=1200
PUBMED_LOCAL_ENABLED=false
PUBMED_LOCAL_SQLITE_PATH=./data/bio_assets/pubmed/pubmed-local.sqlite
PUBMED_LOCAL_MANIFEST_PATH=./data/bio_assets/pubmed/pubmed-local.manifest.json
PUBMED_LOCAL_STARTUP_MATERIALIZATION_ENABLED=false
PUBMED_LOCAL_FALLBACK_ON_NO_HIT=true
PUBMED_LOCAL_MAX_RESULTS=50
PUBMED_LOCAL_REQUIRE_LICENSED_ABSTRACTS=true
PUBMED_LOCAL_MATERIALIZE_TIMEOUT_SECONDS=1200
MAVEDB_LOCAL_ENABLED=false
MAVEDB_LOCAL_SQLITE_PATH=./data/bio_assets/mavedb/mavedb-local.sqlite
MAVEDB_LOCAL_MANIFEST_PATH=./data/bio_assets/mavedb/mavedb-local.manifest.json
MAVEDB_LOCAL_MAX_RESULTS=25
NCBI_EUTILS_API_KEY=
NCBI_EUTILS_TOOL=eamos
NCBI_EUTILS_EMAIL=
CRISPR_PROVIDER=local_deterministic
CRISPR_RSCRIPT_PATH=Rscript
CRISPR_RULESET3_CONDA_ENV=
CRISPR_LINDEL_CONDA_ENV=
PRIMER_SPECIFICITY_PROVIDER=template
UCSC_ISPCR_BINARY_PATH=./bio_assets/bin/isPcr
UCSC_ISPCR_HG38_PATH=./bio_assets/genomes/hg38.2bit
UCSC_ISPCR_TIMEOUT_SECONDS=30
UCSC_ISPCR_MIN_PERFECT=15
UCSC_ISPCR_MIN_GOOD=15
HG38_2BIT_RUNTIME_ASSET_MODE=local_path
HG38_2BIT_RUNTIME_ASSET_PATH=./data/bio_assets/genomes/hg38.2bit
HG38_2BIT_RUNTIME_ASSET_OBJECT_URI=
PROTEIN_ANNOTATION_ENABLED=false
PROTEIN_ANNOTATION_HMMSCAN_PATH=hmmscan
PROTEIN_ANNOTATION_HMMPRESS_PATH=hmmpress
PROTEIN_ANNOTATION_PFAM_HMM_PATH=./data/bio_assets/protein_annotation/Pfam-A.hmm
PROTEIN_ANNOTATION_PFAM_HMM_GZ_PATH=./data/bio_assets/protein_annotation/downloads/Pfam-A.hmm.gz
PROTEIN_ANNOTATION_HMMSCAN_TIMEOUT_SECONDS=30
PROTEIN_ANNOTATION_HMMSCAN_MAX_RESIDUES=5000
PROTEIN_ANNOTATION_HMMPRESS_TIMEOUT_SECONDS=900
PROTEIN_ANNOTATION_REQUIRE_PFAM_INDEXES=true
