ENV=dev
APP_NAME=eamos-backend
HOST=0.0.0.0
PORT=8000
DEBUG=false
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=./data/uploads
FINAL_REPORT_DIR=./data/final_reports
MAX_UPLOAD_MB=20
DATABASE_URL=sqlite+pysqlite:///./data/app.db
JWT_SECRET=change-me-dev-secret-with-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_TTL_DAYS=7
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ALGORITHM=auto
SUPABASE_JWKS_URL=
SUPABASE_JWT_PUBLIC_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REST_TIMEOUT_SECONDS=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_MAX_REQUESTS=60
RATE_LIMIT_AUTH_MAX_REQUESTS=20
RATE_LIMIT_LOOKUP_MAX_REQUESTS=30
RATE_LIMIT_CHAT_MAX_REQUESTS=10
RATE_LIMIT_EVIDENCE_MAX_REQUESTS=10
RATE_LIMIT_PAYMENTS_CHECKOUT_MAX_REQUESTS=6
RATE_LIMIT_PAYMENTS_WEBHOOK_MAX_REQUESTS=60
RATE_LIMIT_WORKBENCH_MAX_REQUESTS=20
RATE_LIMIT_TRUST_PROXY_HEADERS=false
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
USE_REAL_APIS=false
CRISPR_PROVIDER=local_deterministic
CRISPR_RSCRIPT_PATH=Rscript
CRISPR_RULESET3_CONDA_ENV=
CRISPR_LINDEL_CONDA_ENV=
PRIMER_SPECIFICITY_PROVIDER=template
UCSC_ISPCR_BINARY_PATH=./bio_assets/bin/isPcr
UCSC_ISPCR_HG38_PATH=./bio_assets/genomes/hg38.2bit
UCSC_ISPCR_TIMEOUT_SECONDS=30
UCSC_ISPCR_MIN_PERFECT=15
UCSC_ISPCR_MIN_GOOD=15
HG38_2BIT_RUNTIME_ASSET_MODE=local_path
HG38_2BIT_RUNTIME_ASSET_PATH=./data/bio_assets/genomes/hg38.2bit
HG38_2BIT_RUNTIME_ASSET_OBJECT_URI=
VEP_BASE_URL=https://rest.ensembl.org
SPLICEAI_BASE_URL=https://spliceai-38-xwkwwwxdwq-uc.a.run.app/spliceai/
CLINVAR_BASE_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
CLINGEN_EREPO_BASE_URL=https://erepo.clinicalgenome.org/evrepo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_CHECKOUT_SUCCESS_URL=https://eamos.com.au/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=https://eamos.com.au/pricing
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_MAX_MONTHLY=

# GitHub — push scripts
GITHUB_PAT=
