{
  "model": "claude-opus-4-8",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "worktree": {
    "symlinkDirectories": [
      "app/web/node_modules",
      "app/frontend/node_modules"
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(Get-ChildItem *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd app/frontend && npx tsc --noEmit",
            "shell": "bash",
            "timeout": 60,
            "statusMessage": "TypeScript type-check running..."
          }
        ]
      }
    ]
  }
}
